{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
